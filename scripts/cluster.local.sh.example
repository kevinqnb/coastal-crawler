#!/bin/bash
#
# Site-specific bootstrap for the SGE job scripts in this directory
# (submit_extract_job.sh, submit_filter_job.sh).
#
# Copy this file to scripts/cluster.local.sh (gitignored, not tracked) and
# edit it for your environment. It's sourced right after `cd "$REPO_DIR"`,
# before `set -e` is turned on in the calling script — so a failing step
# here (e.g. a Postgres server that's already running) won't kill the job.

# --- Environment modules (skip if your cluster doesn't use module load) -----
module load python3/3.12.4
module load cuda/12.5
module load postgresql/18.1

# scholarlm's DocumentLM (used by `coastal-crawler ocr`) shells out to the
# `tesseract` binary for orientation detection, even in fast=True mode.
# Without it on PATH, fit() warns and silently skips the file, producing no
# OCR text rather than raising — make sure tesseract (plus its own shared-lib
# dependencies, e.g. leptonica/libicu if your tesseract build needs them) is
# on PATH here, however your environment provides it (module load, apt
# package, etc).

# --- HuggingFace cache used by vLLM / serve_model.sh -------------------------
export HF_HOME=/path/to/your/hf-cache

# --- Postgres ------------------------------------------------------------------
# Don't start a Postgres instance directly here if this job and your DB
# server can land on different nodes (e.g. this job requests GPUs and your DB
# job doesn't) — two independent `pg_ctl start` calls against the same data
# directory from different hosts can corrupt it. Instead run Postgres as its
# own long-lived job (see scripts/serve_postgres.sh for a template) that
# writes its current hostname to a well-known shared file, and discover it
# here, e.g.:
#
#   PG_HOST_FILE=/path/to/your/pgserver_host.txt
#   if [ ! -s "$PG_HOST_FILE" ]; then
#       echo "ERROR: $PG_HOST_FILE missing or empty — is your Postgres job running?" >&2
#       exit 1
#   fi
#   export DATABASE_URL="postgresql://youruser@$(cat "$PG_HOST_FILE"):5432/yourdb"
#
# This must be sourced *after* .env in submit_extract_job.sh so it wins over
# .env's own DATABASE_URL (see that script's sourcing order).
#
# If your DB is guaranteed to always be reachable on the same node as this
# job (e.g. a single-node setup), a plain `pg_ctl -D ... start` here is fine.

# --- Python environment -------------------------------------------------------
source .venv/bin/activate
